; Cyber Cipher protocol v1 - RFC 8949 deterministic CBOR profile.

bstr16 = bytes .size 16
bstr32 = bytes .size 32
bstr48 = bytes .size 48
bstr64 = bytes .size 64
field32 = bytes .size 32 ; decoder additionally requires OS2IP(value) < BN254 q
uuid = bstr16
uint32 = 0..4294967295
uint64 = 0..18446744073709551615

matter-ref = [uuid, uint32]

entitlement-message = {
  1: 1,
  2: bstr32, ; matterKeyId
  3: bstr16, ; serial
  4: field32 ; personCommitment
}

entitlement-token = {
  1: entitlement-message,
  2: bstr32, ; RFC 9474 randomized preparation prefix
  3: bytes .size 384 ; RSA-3072 signature
}

membership-checkpoint-body = {
  1: 1,
  2: uint64, ; epoch
  3: field32, ; root
  4: bstr32, ; previousCheckpointHash
  5: uint64, ; publishedAt milliseconds
  6: bstr32, ; updateBatchHash
  7: bstr32 ; signingKeyId
}

membership-checkpoint = {
  1: membership-checkpoint-body,
  2: bstr64
}

membership-operation = {
  1: uint32, ; sequenceInBatch
  2: 1..2, ; activate or revoke
  3: uint32, ; leafIndex
  4: field32 ; new leaf value, including EMPTY_LEAF for revocation
}

membership-delta = {
  1: 1,
  2: uuid, ; SaaS tenantId
  3: uint64, ; epoch
  4: [+ membership-operation]
}

proof-lease-body = {
  1: 1,
  2: bstr16, ; challengeId
  3: 1..2, ; purpose: complaint or vote
  4: uint64, ; epoch
  5: field32, ; root
  6: uint64, ; issuedAt milliseconds
  7: uint64, ; expiresAt milliseconds
  8: bstr32, ; serverNonce
  9: bstr32 ; signingKeyId
}

proof-lease = {
  1: proof-lease-body,
  2: bstr64
}

recovery-challenge-body = {
  1: 1,
  2: uuid, ; SaaS tenantId
  3: bstr16, ; challengeId
  4: bstr16, ; recoveryId
  5: uint32, ; recoveryGeneration
  6: uint64, ; issuedAt milliseconds
  7: uint64, ; expiresAt milliseconds, at most five minutes later
  8: bstr32, ; serverNonce
  9: bstr32 ; signingKeyId
}

recovery-challenge = {
  1: recovery-challenge-body,
  2: bstr64
}

recovery-authorization = {
  1: 1,
  2: uuid, ; SaaS tenantId
  3: bstr32, ; SHA-256(complete signed recovery challenge)
  4: field32, ; stored personAnchor
  5: field32, ; newDeviceHash
  6: bstr16, ; newRecoveryId
  7: bstr32, ; newRecoveryPublicKey
  8: uint32 ; expectedRecoveryGeneration
}

recovery-backup-aad = {
  1: 1,
  2: uuid, ; SaaS tenantId
  3: bstr16, ; recoveryId
  4: 1..2, ; person secret or mailbox bundle
  5: uint32 ; generation
}

proof-envelope = {
  1: 1..2, ; scheme registry: 1 Groth16-BN254, 2 future RSA accumulator
  2: uint32, ; circuitVersion
  3: bstr32, ; artifactId
  4: bytes, ; scheme-defined proof bytes
  5: [+ field32] ; ordered public signals
}

; Wire body accepted by POST /complaints/v1/complaints. The Groth16 proof is
; opaque canonical UTF-8 JSON for the pinned snarkjs backend; public signals
; remain canonical BN254 field byte strings on the protocol boundary.
complaint-submission-request = {
  1: 1,
  2: uuid, ; complaintId
  3: uuid, ; matterId
  4: uint32, ; matterVersion
  5: bytes, ; canonical signed proof-lease CBOR
  6: bstr32, ; matterKeyId
  7: bstr16, ; entitlement serial
  8: field32, ; entitlement personCommitment
  9: bstr32, ; RFC 9474 randomized prefix
  10: bytes .size 384, ; RSA-3072 signature
  11: bstr32, ; complaint circuit artifactId
  12: uint32, ; circuitVersion
  13: [field32, field32, field32, field32, field32, field32, field32, field32],
  14: bytes, ; bounded Groth16 proof JSON
  15: bstr32, ; complaintCommitment
  16: bytes, ; AES-256-GCM ciphertext and tag
  17: bytes .size 12, ; AES-GCM nonce
  18: bstr32, ; HPKE encapsulated key
  19: bstr48, ; HPKE-wrapped DEK and tag
  20: bstr32 ; handlerKeyId
}

complaint-submission-response = {
  1: 1,
  2: uuid,
  3: bstr16, ; receiptId
  4: bytes, ; canonical signed receipt CBOR
  5: bstr32, ; initial log-entry hash
  6: uint64 ; acceptedAt milliseconds
}

attachment-record = {
  1: uint32, ; zero-based index
  2: uint64, ; size
  3: tstr, ; allowlisted MIME type, NFC
  4: tstr, ; sanitized filename, NFC
  5: bstr32 ; hash of final sanitized bytes
}

complaint-manifest = {
  1: 1,
  2: uuid,
  3: uint32,
  4: tstr,
  5: [* attachment-record]
}

private-complaint-package = {
  1: 1,
  2: complaint-manifest,
  3: bstr32, ; commitment salt
  4: [* original-evidence-record],
  5: bstr16, ; mailboxId
  6: bstr32, ; mailbox Ed25519 public key
  7: bstr32 ; mailbox X25519 public key
}

original-evidence-record = {
  1: uint32,
  2: uint64,
  3: tstr,
  4: bstr32,
  5: bytes ; encrypted/original bytes exist only inside outer encrypted package
}

complaint-encryption-aad = {
  1: 1,
  2: uuid, ; complaintId
  3: uuid, ; matterId
  4: uint32, ; matterVersion
  5: bstr32, ; complaintCommitment
  6: bstr32 ; handlerKeyId
}

handler-dek-aad = {
  1: 1,
  2: uuid, ; complaintId
  3: bstr32, ; complaintCommitment
  4: bstr32 ; handlerKeyId
}

mailbox-challenge = {
  1: 1,
  2: bstr16, ; challengeId
  3: bstr16, ; mailboxId
  4: bstr32, ; random challenge
  5: uint64, ; issuedAt milliseconds
  6: uint64  ; expiresAt, at most 60 seconds later
}

mailbox-message-aad = {
  1: 1,
  2: bstr16, ; mailboxId
  3: uint64, ; messageNumber
  4: 1..2, ; user-to-handler or handler-to-user
  5: bstr32, ; previousMessageHash
  6: bstr32  ; recipientKeyId
}

mailbox-message = {
  1: bytes .cbor mailbox-message-aad,
  2: bstr32, ; HPKE encapsulated key
  3: bytes   ; HPKE ciphertext and tag
}

dek-transfer-record = {
  1: 1,
  2: tstr, ; complaint UUID
  3: bstr32, ; immutable ciphertext hash
  4: tstr, ; old organization UUID
  5: tstr, ; new organization UUID
  6: bstr32, ; old handler key ID
  7: bstr32, ; new handler key ID
  8: tstr, ; attributable staff UUID
  9: tstr, ; reason code
  10: uint64 ; occurredAt milliseconds
}

receipt-body = {
  1: 1,
  2: bstr16,
  3: bstr32,
  4: uuid,
  5: uuid,
  6: uint32,
  7: bstr32,
  8: uint64,
  9: bstr32,
  10: bstr32
}

receipt = {
  1: receipt-body,
  2: bstr64
}

log-entry = {
  1: 1,
  2: bstr16,
  3: uint32,
  ? 4: uuid,
  ? 5: uuid,
  ? 6: uint32,
  7: bstr32,
  8: uint64,
  9: uint32,
  ? 10: uint32
}

tree-head-body = {
  1: 1,
  2: uint64, ; treeSize
  3: bstr32, ; rootHash
  4: uint64, ; timestamp milliseconds
  5: bstr32, ; previous finalized STH hash
  6: bstr32 ; logKeyId
}

operator-tree-head = {
  1: tree-head-body,
  2: bstr64 ; log signature
}

tree-head = operator-tree-head

finalized-tree-head = {
  1: bytes .cbor operator-tree-head,
  2: [+ witness-signature]
}

witness-signature = {
  1: bstr32, ; witnessKeyId
  2: bstr64
}

artifact-manifest = {
  1: 1,
  2: tstr, ; circuitName
  3: uint32, ; circuitVersion
  4: uint32, ; treeDepth
  5: tstr, ; proofSystem
  6: tstr, ; curve
  7: tstr, ; compiler version
  8: { * tstr => tstr }, ; dependency versions
  9: bstr32, ; source bundle hash
  10: bstr32, ; R1CS hash
  11: bstr32, ; WASM/prover hash
  12: bstr32, ; proving key hash
  13: bstr32, ; verification key hash
  14: bstr32, ; Powers-of-Tau hash
  15: bstr32, ; phase-two transcript hash
  16: uint64 ; createdAt milliseconds
}
