{
  "name": "@cyber-cipher/ida-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tenant-bound Identity Authority application and HTTP adapters",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "pnpm --filter @cyber-cipher/protocol-core build && pnpm --filter @cyber-cipher/membership-core build && pnpm --filter @cyber-cipher/identity-store build",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "precheck": "pnpm run prebuild",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cyber-cipher/identity-store": "workspace:*",
    "@cyber-cipher/membership-core": "workspace:*",
    "@cyber-cipher/protocol-core": "workspace:*"
  }
}
